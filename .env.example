# Private B1 local installation template. Supply new local credentials only.
APP_NAME=RiseOpenCore
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:18016
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13336
DB_DATABASE=rise_b1_candidate
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file
QUEUE_CONNECTION=database
ACTIVE_THEME=global
CMS_PUBLIC_MAINTENANCE_ENABLED=false
# No provider/SMTP/telemetry credentials or external authorities belong here.

# Sportsbook financial acceptance is restricted to the authorized isolated local profile.
SPORTSBOOK_LOCAL_PARITY_MODE=false
SPORTSBOOK_LOCAL_READ_SOURCE=adapter_live
SPORTSBOOK_LOCAL_WRITE_TARGET=disabled
SPORTSBOOK_LOCAL_FINANCE_ENABLED=false
SPORTSBOOK_LOCAL_FINANCE_SANDBOX=false
SPORTSBOOK_OFFLINE_DEMO_MODE=off
# An operator-owned private adapter config is required for B reads. No provider credentials here.

# ChessBet: existing hosted partner client; no CMS chess engine.
# Default closed. Partner credentials belong only in the private local profile.
CHESS_INTEGRATION_ENABLED=false
CHESS_FRONT_ENABLED=false
CHESS_ADMIN_ENABLED=false
CHESS_WALLET_ENABLED=false
CHESS_WALLET_AUTO_CREATE_PROVIDER=false
CHESS_WALLET_PARTNERS_JSON='{}'
CHESS_EMBED_PUBLIC_BASE_URL=
CHESS_EMBED_EXCHANGE_ENDPOINT=
CHESS_EMBED_PARENT_ORIGIN=
CHESS_EMBED_CHILD_POST_MESSAGE_ORIGIN=
CHESS_EMBED_REQUESTED_HOSTNAME=
CHESS_EMBED_PARTNER_CODE=
CHESS_EMBED_KEY_ID=
CHESS_EMBED_SECRET=
CHESS_EMBED_BOOTSTRAP_SECRET=
CHESS_EMBED_DEBUG_ENABLED=false
CHESS_LIVE_COCKPIT_SOURCE=http
CHESS_LIVE_COCKPIT_HTTP_BASE_URL=
CHESS_LIVE_COCKPIT_HTTP_EVENT_ID=
CHESS_LIVE_COCKPIT_HTTP_SHARED_SECRET=
CHESS_LIVE_COCKPIT_SHADOW_MODE=true
CHESS_LIVE_COCKPIT_MONITORING_ONLY=true

# Nova connector is opt-in. A remote HTTPS authority enables connection verification only.
NOVA_PAYMENTS_ENABLED=false
NOVA_PAYMENTS_URL=
NOVA_PAYMENTS_USERNAME=
NOVA_PAYMENTS_PASSWORD=
NOVA_PAYMENTS_SITE_SECRET=
NOVA_PAYMENTS_FIAT=TRY
NOVA_PAYMENTS_RAIL=btc
# Network defaults to mainnet for an authorized remote authority and testnet for the local fixture.
# NOVA_PAYMENTS_NETWORK_MODE=mainnet
NOVA_PAYMENTS_REMOTE_AUTHORITY=
NOVA_PAYMENTS_REMOTE_SESSIONS_ENABLED=false
NOVA_PAYMENTS_REMOTE_CREDIT_ENABLED=false
