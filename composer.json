{
    "name": "rise/open-core-b1",
    "type": "project",
    "description": "Rise Open Core — independently installable developer platform",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "laravel/framework": "12.71.0",
        "giggsey/libphonenumber-for-php": "8.13.55",
        "intervention/image": "4.4.0",
        "guzzlehttp/guzzle": "7.15.2",
        "ext-intl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.57",
        "mockery/mockery": "1.6.12",
        "fakerphp/faker": "v1.24.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/general.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/OpenCore/"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "*"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
